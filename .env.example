# Local demo is offline and never publishes GitHub comments.
ENVIRONMENT=local
REVIEW_MODE=demo
PUBLISH_REVIEWS=false
DATABASE_URL=sqlite:///reviewer.db
REDIS_URL=redis://localhost:6379/0
GITHUB_WEBHOOK_SECRET=local-demo-webhook-secret
INTERNAL_API_TOKEN=local-demo-internal-token
ALLOWED_REPOSITORIES=demo/example
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional alternative: private key PEM file path (mount into containers if used).
GITHUB_APP_PRIVATE_KEY_PATH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_DIFF_CHARS=100000
MAX_FINDINGS=30
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
